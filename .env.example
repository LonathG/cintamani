# Copy to .env for local development, and set the same four values in
# Netlify → Site configuration → Environment variables for production.
ADMIN_EMAIL=admin@cintamani.lk
ADMIN_PASSWORD=change-me
# Any long random string; changing it signs every admin out.
ADMIN_TOKEN_SECRET=replace-with-a-long-random-string
# Signs customer sign-in sessions (keep different from ADMIN_TOKEN_SECRET).
CUSTOMER_TOKEN_SECRET=replace-with-another-long-random-string
